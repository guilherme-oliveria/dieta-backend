# Copie para .env e ajuste. O arquivo .env não vai para o Git.
POSTGRES_DB=dietamais
POSTGRES_USER=dietamais
POSTGRES_PASSWORD=dietamais
POSTGRES_PORT=5432

# Serviços opcionais: docker compose --profile extras up -d.
# Valores vazios usam defaults exclusivos de desenvolvimento; configure credenciais em produção.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_UI_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Chave estável de 32 bytes aleatórios em Base64; necessária para gravar respostas idempotentes 2xx.
IDEMPOTENCIA_CHAVE=
