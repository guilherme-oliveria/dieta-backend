# Copie para .env.prod e preencha. Nunca versione o .env.prod.
DOMINIO=api.exemplo.com.br
DB_PASSWORD=troque-por-senha-forte
# Par RSA 2048+ em PEM (uma linha, quebras como \n):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-privada.pem
#   openssl rsa -pubout -in jwt-privada.pem -out jwt-publica.pem
#   JWT_CHAVE_PRIVADA="$(awk 'NF{printf "%s\\n",$0}' jwt-privada.pem)"
JWT_CHAVE_PRIVADA=
JWT_CHAVE_PUBLICA=
# 32 bytes em Base64 (openssl rand -base64 32), valores diferentes para cada uma:
IDEMPOTENCIA_CHAVE=
NOTIFICACOES_CHAVE=
# Termo de consentimento clínico (RN-VIN-04) - texto e versão aprovados pelo Guilherme/jurídico.
# Sem isto o paciente não consegue aceitar o convite.
CONSENTIMENTO_VERSAO=
CONSENTIMENTO_TEXTO=
# Origem do site (cookie do refresh) e origens aceitas em CORS (HTTPS exatas, separadas por vírgula); vazio enquanto não há site.
WEB_ORIGEM=
CORS_ORIGENS=
# Versão mínima do app (ex.: 1.4.0). Abaixo disso a API responde 426 e o app pede atualização; vazio desliga.
APP_VERSAO_MINIMA=
# Admin da plataforma, criado na primeira subida (senha com 12+ caracteres; troque depois pelo fluxo de senha).
ADMIN_EMAIL=
ADMIN_SENHA=
# Pagamento Asaas (BE-26). Sem chave o checkout fica indisponível. O webhook aponta para https://DOMINIO/api/v1/webhooks/pagamento com este token.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_URL_BASE=https://api-sandbox.asaas.com
# Push (Firebase) - JSON da conta de serviço em uma linha
PUSH_ENVIO_HABILITADO=false
FCM_CREDENCIAIS_JSON=
# Arquivos gerados (PDF, logo): disco no volume `arquivos`. ARQUIVOS_SEGREDO assina os links (openssl rand -base64 32).
ARQUIVOS_SEGREDO=
# Opcional: S3/MinIO no lugar do disco
S3_ENDPOINT=
S3_BUCKET=dietamais
S3_REGIAO=us-east-1
S3_CHAVE_ACESSO=
S3_CHAVE_SECRETA=
# E-mail (opcional no beta: com EMAIL_ENVIO_HABILITADO=false nada é enviado)
EMAIL_ENVIO_HABILITADO=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=
# Backup: BACKUP_SENHA criptografa os dumps (AES-256). Guarde-a FORA do servidor: sem ela o backup não restaura.
BACKUP_SENHA=
DIAS_RETENCAO=14
HORA_BACKUP=03:00
